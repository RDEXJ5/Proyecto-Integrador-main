# Nunca subas el archivo .env. Genera secretos aleatorios de al menos 32 bytes.
NODE_ENV=development
PORT=3000
API_PORT=3000
MOBILE_API_PORT=3001
# Use 0.0.0.0 sólo durante pruebas con un teléfono en la misma red local.
# Use 0.0.0.0 para probar desde un teléfono en la misma red local.
MOBILE_API_BIND_ADDRESS=127.0.0.1
WEB_PORT=5000

# Variables para ejecutar Node fuera de Docker.
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=juzgado_nulidad_documental
DB_USER=api_user
DB_PASSWORD=replace_with_a_strong_database_password

# Variables exclusivas del servicio MySQL de docker-compose.
MYSQL_DATABASE=juzgado_nulidad_documental
MYSQL_USER=api_user
MYSQL_PASSWORD=replace_with_a_strong_database_password
MYSQL_ROOT_PASSWORD=replace_with_a_different_strong_root_password

# Almacenamiento documental. MinIO exige secretos de al menos 8 caracteres.
# Las variables reales viven en .env.storage, que tampoco debe versionarse.
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001
# Si el proyecto está en OneDrive, apunta a un archivo local fuera de la nube.
STORAGE_ENV_FILE=.env.storage

# Token de usuario: firmado, con vencimiento, y nunca almacenado en la BD.
JWT_SECRET=replace_with_a_random_secret_of_at_least_32_characters
JWT_EXPIRES_IN=30m
JWT_ISSUER=sistema-nulidad-api
JWT_AUDIENCE=sistema-nulidad-clients

# Exclusiva para comunicación entre servicios, no para la app móvil o web.
API_APPLICATION_KEY=replace_with_a_random_system_api_key_of_at_least_32_characters

# Clave independiente para las constancias de integridad de la plataforma.
# No es la contraseña del usuario ni sustituye un certificado legal cualificado.
PLATFORM_SIGNATURE_SECRET=replace_with_a_random_signature_secret_of_at_least_32_characters

# Sesión del servidor Flask. Usa false solo durante pruebas locales sin HTTPS.
FLASK_SECRET_KEY=replace_with_a_different_random_secret_of_at_least_32_characters
SESSION_COOKIE_SECURE=false

# Lista separada por comas. Ajustar al origen real del frontend web.
CORS_ORIGINS=http://localhost:8081,http://localhost:3000

# Monitoreo local. En producción reemplace todas las contraseñas y use un
# certificado TLS emitido para el dominio real.
HAPROXY_BIND_ADDRESS=127.0.0.1
HAPROXY_HTTP_PORT=8088
HAPROXY_HTTPS_PORT=8443
PROMETHEUS_RETENTION=15d
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=2318
GRAFANA_ROOT_URL=https://localhost:8443/grafana/
MYSQL_EXPORTER_PASSWORD=2318
