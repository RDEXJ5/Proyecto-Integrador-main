# Copie como private.storage.env. Recupere los valores reales desde Secret Manager.
MINIO_ROOT_USER=replace_with_a_private_root_user
MINIO_ROOT_PASSWORD=replace_with_a_unique_minio_root_password
MINIO_ACCESS_KEY=replace_with_a_private_api_user
MINIO_SECRET_KEY=replace_with_a_unique_minio_api_password
MINIO_ENDPOINT=minio
MINIO_PORT=9000
MINIO_USE_SSL=false
MINIO_BUCKET=expediente-documentos
DOCUMENT_ENCRYPTION_KEY=replace_with_32_random_bytes_encoded_as_base64
MAX_DOCUMENT_BYTES=26214400

