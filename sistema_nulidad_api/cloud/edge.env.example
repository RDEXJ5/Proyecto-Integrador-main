# Copie como edge.env en el servidor público. No versione edge.env.
PUBLIC_DOMAIN=gdi.example.com
EDGE_PRIVATE_BIND_ADDRESS=10.20.0.10
PRIVATE_SERVER_IP=10.20.0.20
TLS_CERT_FILE=./secrets/server.pem

# Proteccion de HAProxy. Son valores iniciales y deben ajustarse despues de una
# prueba de carga controlada. El endpoint /__proxy_health queda excluido.
HAPROXY_GLOBAL_MAXCONN=4096
HAPROXY_REQUESTS_PER_10S=30
HAPROXY_GRAFANA_REQUESTS_PER_10S=100
HAPROXY_CONNECTIONS_PER_IP=10
HAPROXY_WEB_API_MAXCONN=100
HAPROXY_MOBILE_API_MAXCONN=100
HAPROXY_WEB_MAXCONN=32
HAPROXY_GRAFANA_MAXCONN=50
HAPROXY_BACKEND_MAXQUEUE=100

GRAFANA_ADMIN_USER=replace_with_a_non_default_admin_name
GRAFANA_ADMIN_PASSWORD=replace_with_a_unique_grafana_password
GRAFANA_SECRET_KEY=replace_with_a_random_grafana_secret_of_at_least_32_characters
