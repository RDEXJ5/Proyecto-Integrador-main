# Copie como edge.env en el servidor público. No versione edge.env.
PUBLIC_DOMAIN=gdi.example.com
EDGE_PRIVATE_BIND_ADDRESS=10.20.0.10
PRIVATE_SERVER_IP=10.20.0.20
TLS_CERT_FILE=./secrets/server.pem

GRAFANA_ADMIN_USER=replace_with_a_non_default_admin_name
GRAFANA_ADMIN_PASSWORD=replace_with_a_unique_grafana_password
GRAFANA_SECRET_KEY=replace_with_a_random_grafana_secret_of_at_least_32_characters
