# Copie como private.env en el servidor privado. No versione private.env.
# Use la IP interna reservada de la VM, nunca 0.0.0.0.
PRIVATE_BIND_ADDRESS=10.20.0.20
EDGE_PRIVATE_IP=10.20.0.10
PRIVATE_STORAGE_ENV_FILE=./private.storage.env

MYSQL_DATABASE=juzgado_nulidad_documental
MYSQL_USER=api_user
MYSQL_PASSWORD=replace_with_a_unique_database_password
MYSQL_ROOT_PASSWORD=replace_with_a_different_root_password
MYSQL_EXPORTER_PASSWORD=replace_with_a_monitoring_only_password

JWT_SECRET=replace_with_a_random_secret_of_at_least_32_characters
JWT_EXPIRES_IN=30m
JWT_ISSUER=sistema-nulidad-api
JWT_AUDIENCE=sistema-nulidad-clients
API_APPLICATION_KEY=replace_with_a_random_system_key_of_at_least_32_characters
PLATFORM_SIGNATURE_SECRET=replace_with_a_random_signature_secret_of_at_least_32_characters
FLASK_SECRET_KEY=replace_with_a_random_flask_secret_of_at_least_32_characters
CORS_ORIGINS=https://gdi.example.com
PROMETHEUS_RETENTION=30d

