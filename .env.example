# Copy this file to .env and replace every development value before deployment.
MYSQL_DATABASE=control_documental
MYSQL_USER=appuser
MYSQL_PASSWORD=change_this_database_password
MYSQL_ROOT_PASSWORD=change_this_root_password

DB_HOST=mysql
DB_PORT=3306
DB_NAME=control_documental
DB_USER=appuser
DB_PASSWORD=change_this_database_password

# Generate long random values for production. The Fernet value must be a valid
# url-safe base64 key produced by cryptography.fernet.Fernet.generate_key().
API_APPLICATION_KEY=change_this_application_key
JWT_SECRET_KEY=change_this_long_jwt_secret
FILE_ENCRYPTION_KEY=MDAwMDAwMDAwMDAwMDAwMDAwMDAwMDAwMDAwMDAwMDA=
BOOTSTRAP_TOKEN=change_this_one_time_bootstrap_token
APP_ENV=development
GRAFANA_ADMIN_PASSWORD=change_this_grafana_password

FLASK_SECRET_KEY=change_this_flask_secret
API_BASE_URL=http://api:8000
