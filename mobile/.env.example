# Seleccione una sola dirección y quite el comentario correspondiente.

# Expo Web o simulador iOS en el mismo equipo:
# EXPO_PUBLIC_MOBILE_API_URL=http://127.0.0.1:3001

# Emulador Android:
# EXPO_PUBLIC_MOBILE_API_URL=http://10.0.2.2:3001

# Teléfono físico en la misma red (sustituya por la IP LAN del equipo):
# EXPO_PUBLIC_MOBILE_API_URL=http://192.168.1.20:3001

# API móvil publicada en Cloud mediante HAProxy (use el dominio del certificado):
# EXPO_PUBLIC_MOBILE_API_URL=https://gdi.example.com/mobile-api
